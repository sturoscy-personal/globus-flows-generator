GLOBUS_COMPUTE_CLIENT_ID=
GLOBUS_COMPUTE_CLIENT_SECRET=
# Destination folder shared by your Globus Connect Personal collection.
# Use an absolute path (Compose does not expand ~ here). The source folder
# (~/globus-source) must NOT be mounted into the container.
DATA_DIR=~/globus-destination

# Globus client used by the ingest function to write to Search.
# Needs the writer role on the target index.
GLOBUS_SEARCH_CLIENT_ID=
GLOBUS_SEARCH_CLIENT_SECRET=
